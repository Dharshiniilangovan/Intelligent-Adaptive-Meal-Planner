# ============================================================
# HELPERS
# ============================================================

def print_result(
    title,
    meal_slot,
    plan_context,
    result,
):
    """
    Print compact Day-5 test output.
    """

    print("\n" + "=" * 70)
    print(title)
    print("=" * 70)

    print(
        "Meal Slot:",
        meal_slot,
    )

    print(
        "Plan Context:",
        plan_context,
    )

    print(
        "Status:",
        result.get("status"),
    )

    candidate_ids = (
        result
        .get("data", {})
        .get(
            "candidate_recipe_ids",
            [],
        )
    )

    print(
        "Candidate Count:",
        len(candidate_ids),
    )

    print(
        "Candidate IDs:",
        candidate_ids,
    )

    if result.get("warnings"):
        print(
            "Warnings:",
            result["warnings"],
        )

    if result.get("errors"):
        print(
            "Errors:",
            result["errors"],
        )


def get_candidate_recipes(
    candidate_ids,
):
    """
    Retrieve candidate rows from the real Recipe KB.
    """

    df = load_recipe_kb()

    return df[
        df["recipe_id"].isin(
            candidate_ids
        )
    ]


def basic_user_state():
    """
    Basic User State used by Day-5 tests.
    """

    return {
        "dietary_restrictions": [],
        "preferred_cuisines": [],
        "preferred_meal_types": [],
    }


# ============================================================
# TEST 1
# LUNCH SLOT
# ============================================================

def test_day5_lunch_slot():

    agent = RecipeAgent(
        max_candidates=5
    )

    user_state = basic_user_state()

    meal_slot = {
        "meal_type": "lunch",
        "max_cooking_time": None,
    }

    plan_context = {
        "used_recipe_ids": [],
        "recent_cuisines": [],
    }

    result = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context=plan_context,
    )

    print_result(
        "DAY 5 TEST 1: Lunch Slot",
        meal_slot,
        plan_context,
        result,
    )

    assert result["status"] == "success"

    candidate_ids = (
        result["data"][
            "candidate_recipe_ids"
        ]
    )

    assert candidate_ids

    recipes = get_candidate_recipes(
        candidate_ids
    )

    for _, recipe in recipes.iterrows():

        assert _contains_label(
            recipe.get(
                "meal_type",
                "",
            ),
            "lunch",
        )


