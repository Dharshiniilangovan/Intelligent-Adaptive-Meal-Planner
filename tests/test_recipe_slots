# TEST 3
# USED RECIPE EXCLUSION
# ============================================================

def test_day5_used_recipe_exclusion():

    agent = RecipeAgent(
        max_candidates=5
    )

    user_state = basic_user_state()

    meal_slot = {
        "meal_type": "dinner",
        "max_cooking_time": None,
    }

    # First retrieval
    first_result = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context={
            "used_recipe_ids": [],
            "recent_cuisines": [],
        },
    )

    first_ids = (
        first_result["data"][
            "candidate_recipe_ids"
        ]
    )

    assert first_ids

    used_recipe_id = first_ids[0]

    # Simulate that recipe being selected
    plan_context = {
        "used_recipe_ids": [
            used_recipe_id
        ],
        "recent_cuisines": [],
    }

    result = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context=plan_context,
    )

    print_result(
        "DAY 5 TEST 3: Used Recipe Exclusion",
        meal_slot,
        plan_context,
        result,
    )

    candidate_ids = (
        result["data"][
            "candidate_recipe_ids"
        ]
    )

    print(
        "Previously Used Recipe:",
        used_recipe_id,
    )

    assert (
        used_recipe_id
        not in candidate_ids
    )


