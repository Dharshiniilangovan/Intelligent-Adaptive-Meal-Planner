# ============================================================
# TEST 5
# COOKING-TIME CONTEXT
# ============================================================

def test_day5_cooking_time_context():

    agent = RecipeAgent(
        max_candidates=5
    )

    user_state = basic_user_state()

    meal_slot = {
        "meal_type": "dinner",
        "max_cooking_time": 20,
    }

    plan_context = {
        "used_recipe_ids": [],
        "recent_cuisines": [],
    }

    result = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context=plan_context,
    )

    print_result(
        "DAY 5 TEST 5: Cooking Time Context",
        meal_slot,
        plan_context,
        result,
    )

    assert result["status"] == "success"

    candidate_ids = (
        result["data"][
            "candidate_recipe_ids"
        ]
    )

    assert isinstance(
        candidate_ids,
        list,
    )

    df = load_recipe_kb()

    # --------------------------------------------------------
    # CURRENT KB MAY NOT HAVE KNOWN COOKING TIMES
    # --------------------------------------------------------

    if (
        "cooking_time_min"
        not in df.columns
    ):

        assert any(
            "cooking-time"
            in warning.lower()

            for warning
            in result["warnings"]
        )

        return

    cooking_times = pd.to_numeric(
        df["cooking_time_min"],
        errors="coerce",
    )

    if not cooking_times.notna().any():

        # No time values available:
        # agent must warn instead of inventing values.

        assert any(
            "cooking-time"
            in warning.lower()

            for warning
            in result["warnings"]
        )

    else:

        recipes = get_candidate_recipes(
            candidate_ids
        )

        candidate_times = pd.to_numeric(
            recipes[
                "cooking_time_min"
            ],
            errors="coerce",
        )

        known_times = (
            candidate_times
            .dropna()
        )

        assert all(
            known_times <= 20
        )


