# ============================================================
# TEST 8
# BASIC CUISINE VARIETY
# ============================================================

def test_day5_variety_behavior():

    agent = RecipeAgent(
        max_candidates=10
    )

    user_state = {
        "dietary_restrictions": [],
        "preferred_cuisines": [
            "Asian"
        ],
        "preferred_meal_types": [],
    }

    meal_slot = {
        "meal_type": "dinner",
        "max_cooking_time": None,
    }

    # --------------------------------------------------------
    # WITHOUT RECENT CUISINE HISTORY
    # --------------------------------------------------------

    baseline = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context={
            "used_recipe_ids": [],
            "recent_cuisines": [],
        },
    )

    baseline_ids = (
        baseline["data"][
            "candidate_recipe_ids"
        ]
    )

    # --------------------------------------------------------
    # AFTER SEVERAL ASIAN MEALS
    # --------------------------------------------------------

    plan_context = {
        "used_recipe_ids": [],
        "recent_cuisines": [
            "Asian",
            "Asian",
            "Asian",
        ],
    }

    result = agent.run(
        user_state=user_state,
        meal_slot=meal_slot,
        plan_context=plan_context,
    )

    print_result(
        "DAY 5 TEST 8: Cuisine Variety",
        meal_slot,
        plan_context,
        result,
    )

    candidate_ids = (
        result["data"][
            "candidate_recipe_ids"
        ]
    )

    assert result["status"] == "success"

    assert isinstance(
        candidate_ids,
        list,
    )

    # Variety is a ranking preference,
    # not a hard constraint.
    #
    # All returned IDs must remain valid.

    df = load_recipe_kb()

    valid_ids = set(
        df[
            "recipe_id"
        ]
        .astype(str)
        .tolist()
    )

    assert all(
        recipe_id in valid_ids

        for recipe_id
        in candidate_ids
    )

    print(
        "Baseline Candidates:",
        baseline_ids,
    )

    print(
        "After Variety Ranking:",
        candidate_ids,
    )